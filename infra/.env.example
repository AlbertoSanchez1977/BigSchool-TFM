# Variables de entorno para Docker Compose
# Copiar este archivo como .env y completar los valores

# ========== MySQL ==========
MYSQL_ROOT_PASSWORD=BigSchool_Root_2026!
MYSQL_DATABASE=bigschool
MYSQL_USER=bigschool_user
MYSQL_PASSWORD=BigSchool_Dev_2026!

# ========== Azure OpenAI ==========
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-ada-002

# ========== Qdrant ==========
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=bigschool_documents

# ========== JWT ==========
JWT_SECRET=YourSuperSecretKeyForDevelopment_AtLeast32Chars!
JWT_ISSUER=bigschool-tfm
JWT_AUDIENCE=bigschool-tfm
JWT_EXPIRATION_MINUTES=60

# ========== RAG Service ==========
RAG_SERVICE_URL=http://rag-service:8000

# ========== Backend ==========
BACKEND_URL=http://backend:5000
ASPNETCORE_ENVIRONMENT=Development
