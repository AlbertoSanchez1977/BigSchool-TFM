# URL base del backend de desarrollo (incluye el prefijo de versión /api/v1).
# En Next.js, las variables con prefijo NEXT_PUBLIC_ se exponen al navegador.
# Las que NO tienen ese prefijo solo están disponibles en el servidor (Server Components, Route Handlers).
# Como el apiClient corre en el navegador, necesita NEXT_PUBLIC_.
# Todos los controllers del backend cuelgan de /api/v1 (api/v1/auth, api/v1/transactions, ...).
NEXT_PUBLIC_API_URL=http://localhost:5285/api/v1

# AI Scanner: 'true' activa la pantalla completa; 'false' (default) muestra "Próximamente".
# No hay backend de IA aún — activar solo para demo local.
NEXT_PUBLIC_AI_SCANNER_ENABLED=false
