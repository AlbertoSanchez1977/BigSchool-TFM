# =========================
# BigSchool-TFM .gitignore
# =========================

# ---- .NET / C# ----
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates
*.dll
*.exe
*.pdb
.vs/
packages/
*.nupkg

# ---- Node.js / TypeScript ----
node_modules/
.next/
out/
dist/
*.tsbuildinfo
.turbo/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
.eggs/

# ---- React Native / Expo ----
.expo/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/

# ---- Docker ----
# No ignorar docker-compose ni Dockerfiles

# ---- IDE ----
.idea/
.vscode/
*.lscache
*.swp
*.swo
*~

# ---- OS ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- Entorno ----
.env
.env.local
.env.*.local
!.env.example
!infra/.env.example

# ---- Logs ----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---- Coverage ----
coverage/
*.lcov
.nyc_output/

# ---- Misc ----
*.bak
*.tmp
*.temp
